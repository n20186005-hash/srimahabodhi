{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "srimahabodhi",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "main": "worker/index.mjs"
}
