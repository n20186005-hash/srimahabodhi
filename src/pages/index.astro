---
import '../styles/global.css';
import {
  getWeatherSnapshot,
  weatherCodeToText,
  buildWeatherAdvice,
  formatNumber,
  windLabel,
  uvLabel,
  humidityLabel,
  feelsLabel,
  ADVICE_CLASS
} from '../lib/weather';

/* ------------------------------------------------------------------ *
 * 单景点 SEO 实体绑定配置变量（Single-attraction entity binding）
 * ------------------------------------------------------------------ */
const DOMAIN_NAME = 'srimahabodhi.com';
const ATTRACTION_FULL_NAME = 'Jaya Sri Maha Bodhi';
const ATTRACTION_SHORT_NAME = 'Sri Maha Bodhi';
const ATTRACTION_LOCAL_NAME = 'ජය ශ්‍රී මහා බෝධිය';
const CITY_NAME = 'Anuradhapura';
const CITY_LOCAL_NAME = 'අනුරාධපුර';
const STATE_PROVINCE = 'North Central Province';
const STATE_PROVINCE_LOCAL = 'උතුරු මැද පළාත';
const COUNTRY_NAME = 'Sri Lanka';
const COUNTRY_LOCAL_NAME = 'ශ්‍රී ලංකාව';
const COUNTRY_CODE_2LETTER = 'LK';
const POSTAL_CODE = '50000';
const LATITUDE = 8.3446448;
const LONGITUDE = 80.3972292;
const MAPS_SHARE_URL = 'https://maps.app.goo.gl/Xm4DV3tAoWF94of36';
const MAPS_EMBED_SRC = 'https://www.google.com/maps?q=8.3446448,80.3972292&hl=si&gl=lk&z=16&output=embed';
const NEARBY_LANDMARK_1 = 'Ruwanwelisaya';
const NEARBY_LANDMARK_2 = 'Lovamahapaya';
const GOVT_TOURISM_URL = 'https://www.sltda.gov.lk/';
const TELEPHONE = '+94 25 222 2367';
const PLUS_CODE = '89VW+VV5, Anuradhapura, Sri Lanka';

/* Google Maps 评分 / 评价同步信息（页面展示 + TouristAttraction JSON-LD 的 aggregateRating 同源） */
const RATING_VALUE = '4.9';
const RATING_BEST = '5';
const REVIEW_COUNT = '14,999';
const REVIEW_COUNT_NUM = 14999;
const REVIEW_SYNC_DATE = '2026 සැප්තැම්බර්';
const REVIEW_SYNC_DATE_EN = 'September 2026';
const STAR_WIDTH = `${(4.9 / 5) * 100}%`;

const siteUrl = (Astro.site?.toString() ?? `https://${DOMAIN_NAME}`).replace(/\/$/, '');
const canonical = `${siteUrl}/`;
const heroImage = `${siteUrl}/images/jaya-sri-maha-bodhi-hero.jpg`;
const pilgrimsImage = `${siteUrl}/images/jaya-sri-maha-bodhi-pilgrims.jpg`;
const flagsImage = `${siteUrl}/images/jaya-sri-maha-bodhiya-flags.jpg`;

/* ------------------------------------------------------------------ *
 * 天气：服务器端获取并缓存（构建/渲染期取数，浏览器端定时刷新保持实时）
 * ------------------------------------------------------------------ */
const weather = await getWeatherSnapshot(LATITUDE, LONGITUDE);
const weatherNow = weather.now;
const weatherDays = weather.days.slice(0, 7);
const weatherText = weatherCodeToText(weatherNow.weatherCode);

const SINHALA_WEEKDAYS = ['ඉරිදා', 'සඳුදා', 'අඟහරුවාදා', 'බදාදා', 'බ්‍රහස්පතින්දා', 'සිකුරාදා', 'සෙනසුරාදා'];
const EN_SHORT_DATE = new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short' });

function colomboStamp(input: string): string {
  const date = new Date(input);
  if (Number.isNaN(date.getTime())) return '—';
  const pad = (value: number) => String(value).padStart(2, '0');
  const colombo = new Date(date.getTime() + 5.5 * 60 * 60 * 1000);
  return `${colombo.getUTCFullYear()}-${pad(colombo.getUTCMonth() + 1)}-${pad(colombo.getUTCDate())} ${pad(colombo.getUTCHours())}:${pad(colombo.getUTCMinutes())}`;
}

const weatherUpdatedLabel = colomboStamp(weatherNow.time);
const weatherAdvice = buildWeatherAdvice({ ...weather, days: weatherDays });
const weatherToday = weatherDays[0] ?? null;
const windWord = windLabel(weatherNow.windSpeed);
const uvWord = uvLabel(weatherToday?.uvIndexMax ?? weatherNow.uvIndex);
const airWord = humidityLabel(weatherNow.humidity);
const feelsWord = feelsLabel(weatherNow);
const todayRainChance =
  weatherToday?.precipitationProbability === null || weatherToday?.precipitationProbability === undefined
    ? '—'
    : `${Math.round(weatherToday.precipitationProbability)}%`;
const weatherRows = weatherDays.map((day, index) => {
  const date = new Date(`${day.date}T00:00:00Z`);
  const text = weatherCodeToText(day.weatherCode);
  return {
    index,
    isToday: index === 0,
    weekdaySi: SINHALA_WEEKDAYS[date.getUTCDay()] ?? '',
    dateEn: EN_SHORT_DATE.format(date),
    text,
    tempMax: formatNumber(day.tempMax),
    tempMin: formatNumber(day.tempMin),
    rain: formatNumber(day.precipitation, 1),
    rainChance: day.precipitationProbability === null ? '—' : `${Math.round(day.precipitationProbability)}%`,
    uv: formatNumber(day.uvIndexMax, 0)
  };
});

const pageTitle = `${ATTRACTION_LOCAL_NAME} | ${ATTRACTION_FULL_NAME} (${CITY_NAME}) — Visitor Guide: Opening Hours, History & Location`;
const pageDescription = `${ATTRACTION_FULL_NAME} (${ATTRACTION_LOCAL_NAME}) — ${CITY_LOCAL_NAME}යේ පූජනීය බෝධි වෘක්ෂය සඳහා සංචාරක මාර්ගෝපදේශය: විවෘත වේලාව, ගාස්තු, ඇඳුම් නීති, ඉතිහාසය සහ අවට ස්ථාන. Plan your visit to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}: opening hours, history, dress code, how to reach, and nearby ${NEARBY_LANDMARK_1} & ${NEARBY_LANDMARK_2}.`;
const ogTitle = `${ATTRACTION_FULL_NAME} - ${CITY_NAME} Travel Guide`;
const ogDescription = `${ATTRACTION_LOCAL_NAME} සඳහා සංචාරක මාර්ගෝපදේශය · Official visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`;

/* 1. TouristAttraction 结构化数据（补全 @id / image / alternateName） */
const attraction = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteUrl}/#attraction`,
  name: ATTRACTION_FULL_NAME,
  alternateName: [
    ATTRACTION_SHORT_NAME,
    `${CITY_NAME} ${ATTRACTION_FULL_NAME}`,
    ATTRACTION_LOCAL_NAME
  ],
  description: `Comprehensive visitor guide to ${ATTRACTION_FULL_NAME} in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME}.`,
  url: canonical,
  image: [heroImage, pilgrimsImage, flagsImage],
  telephone: TELEPHONE,
  isAccessibleForFree: true,
  publicAccess: true,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: RATING_VALUE,
    reviewCount: REVIEW_COUNT_NUM,
    bestRating: RATING_BEST
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: PLUS_CODE,
    addressLocality: CITY_NAME,
    addressRegion: STATE_PROVINCE,
    postalCode: POSTAL_CODE,
    addressCountry: COUNTRY_CODE_2LETTER
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: LATITUDE,
    longitude: LONGITUDE
  },
  hasMap: MAPS_SHARE_URL,
  sameAs: [MAPS_SHARE_URL, GOVT_TOURISM_URL],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '06:15',
      closes: '21:00'
    }
  ]
};

/* 面包屑：地理归属层级 Sri Lanka → North Central Province → Anuradhapura → Jaya Sri Maha Bodhi */
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: `${COUNTRY_NAME} / ${COUNTRY_LOCAL_NAME}`, item: `${siteUrl}/#top` },
    { '@type': 'ListItem', position: 2, name: `${STATE_PROVINCE} / ${STATE_PROVINCE_LOCAL}`, item: `${siteUrl}/#location` },
    { '@type': 'ListItem', position: 3, name: `${CITY_NAME} / ${CITY_LOCAL_NAME}`, item: `${siteUrl}/#location` },
    { '@type': 'ListItem', position: 4, name: `${ATTRACTION_FULL_NAME} / ${ATTRACTION_LOCAL_NAME}`, item: `${siteUrl}/#attraction` }
  ]
};

/* 4. FAQPage 结构化数据（与页面可见内容一一对应） */
const faqItems = [
  {
    q: `${ATTRACTION_LOCAL_NAME} (${ATTRACTION_FULL_NAME}) පිහිටා ඇත්තේ කොහේද? — Where is ${ATTRACTION_FULL_NAME} located?`,
    a: `${ATTRACTION_FULL_NAME} (${ATTRACTION_LOCAL_NAME}) is located in ${CITY_NAME}, ${STATE_PROVINCE}, ${COUNTRY_NAME} (${PLUS_CODE}, coordinates ${LATITUDE}, ${LONGITUDE}). ${ATTRACTION_LOCAL_NAME} පිහිටා ඇත්තේ ${CITY_LOCAL_NAME}, ${STATE_PROVINCE_LOCAL}, ${COUNTRY_LOCAL_NAME} හි මහමෙව්නා උයනේ ය.`
  },
  {
    q: `${ATTRACTION_SHORT_NAME} නැරඹීමට ගාස්තුවක් තිබේද? — Is ${ATTRACTION_SHORT_NAME} free to visit?`,
    a: `පූජනීය බෝධියට ප්‍රවේශය සාමාන්‍යයෙන් නොමිලේ ලෙස දක්වා ඇත. නමුත් අනුරාධපුර පුරාවිද්‍යා කලාපයේ වෙනත් ස්ථාන සඳහා වෙනම ප්‍රවේශ ගාස්තු තිබිය හැක. Yes, ${ATTRACTION_FULL_NAME} is a public sacred space and is free to visit year-round; separate tickets may apply to other archaeological sites nearby.`
  },
  {
    q: `විවෘත වේලාව කුමක්ද? — What are the opening hours?`,
    a: `සාමාන්‍යයෙන් පෙ.ව. 6:15 සිට රාත්‍රී 9:00 දක්වා ලෙස ලැයිස්තුගත වේ. විශේෂ පූජා හෝ පෝය දිනවල වෙනස්කම් විය හැක. Listed hours are approximately 06:15–21:00 daily; check locally on Poya and festival days.`
  },
  {
    q: 'නැරඹීමට හොඳම වේලාව කවදාද?',
    a: 'අලුයම හෝ සවස උණුසුම අඩු වේලාව සන්සුන් අත්දැකීමක් ලබා දෙයි. පෝය දිනවල විශාල වන්දනාකරුවන් පිරිසක් පැමිණිය හැක.'
  },
  {
    q: 'ඇඳුම් සහ හැසිරීම් පිළිබඳ නීති මොනවාද?',
    a: 'උරහිස් හා දණ වැසෙන ගෞරවාන්විත ඇඳුම් ඇඳීම සුදුසුය. පූජනීය ප්‍රදේශයට ඇතුල්වීමට පෙර සපත්තු සහ හිස්වැසුම් ඉවත් කර නිහඬව හැසිරෙන්න.'
  },
  {
    q: 'කොපමණ කාලයක් වෙන් කළ යුතුද?',
    a: 'පූජනීය පරිශ්‍රය සඳහා සාමාන්‍යයෙන් මිනිත්තු 30 සිට පැය 1.5 දක්වා වෙන් කිරීම ප්‍රමාණවත්ය. අවට රුවන්වැලි මහා සෑය හා ලෝවාමහාපාය එක් කරන්නේ නම් වැඩි කාලයක් වෙන් කරන්න.'
  },
  {
    q: 'ඡායාරූප ගත හැකිද?',
    a: 'සාමාන්‍යයෙන් ගෞරවාන්විත ඡායාරූප ගැනීම සිදු කළ හැකි නමුත් වන්දනාකරුවන්, භික්ෂූන් වහන්සේලා හෝ පූජා කටයුතු බාධා නොකරන්න. පූජනීය වෘක්ෂය පිටුපස තබාගෙන පෝස් කිරීම වැනි ක්‍රියා වලින් වළකින්න.'
  },
  {
    q: 'පෝය දිනවල යාම හොඳද?',
    a: 'පෝය දිනවල ආගමික වාතාවරණය විශේෂ වේ, නමුත් විශාල වන්දනාකරුවන් පිරිසක් බලාපොරොත්තු විය යුතුය. සන්සුන් අත්දැකීමක් සඳහා සාමාන්‍ය සතියේ අලුයම වඩා සුදුසු විය හැක.'
  },
  {
    q: 'ළමුන් සමඟ පැමිණිය හැකිද?',
    a: 'ඔව්. පූජනීය බව පැහැදිලි කර දී ශබ්දය අඩු කරමින්, පූජා ප්‍රදේශවල දුවීමෙන් හෝ අතපත ගෑමෙන් වළක්වා ගැනීම සුදුසුය.'
  },
  {
    q: 'නැරඹීමට වඩාත් සුදුසු සමය කුමක්ද? — What is the best season to visit?',
    a: `අනුරාධපුරය වියළි කලාපයක පිහිටා ඇත. ජනවාරි සිට මාර්තු දක්වා කාලය සාපේක්ෂව සිසිල් හා වියළි වේ. අප්‍රේල් මාසය වඩාත් උණුසුම්ම වන අතර ඔක්තෝබර්–දෙසැම්බර් ඊසාන දිග මෝසම් වැසි ගෙන එයි. Anuradhapura lies in the dry zone: January–March is comparatively dry and pleasant, April is the hottest month, and October–December brings the north-east monsoon rains.`
  },
  {
    q: 'වර්ෂාව පැමිණියහොත් කුඩයක් අවශ්‍යද? — Do I need rain gear?',
