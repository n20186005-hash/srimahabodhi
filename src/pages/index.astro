          <article class="card rounded-3xl p-6"><span class="text-3xl">🎟️</span><h3 class="mt-5 text-xl font-extrabold">ප්‍රවේශ ගාස්තුව</h3><p class="mt-2 leading-7 text-[#665444]">බෝධි පරිශ්‍රයට ප්‍රවේශය නොමිලේ ලෙස වාර්තා වේ. අවට පුරාවිද්‍යා ස්ථාන සඳහා වෙනම ටිකට් අවශ්‍ය විය හැක.</p></article>
          <article class="card rounded-3xl p-6"><span class="text-3xl">⏳</span><h3 class="mt-5 text-xl font-extrabold">රැඳී සිටින කාලය</h3><p class="mt-2 leading-7 text-[#665444]">මිනිත්තු 30–90. වන්දනා, නිහඬව වාඩිවීම හෝ අවට පූජනීය ස්ථාන එකතු කරන්නේ නම් වැඩි කාලයක් වෙන් කරන්න.</p></article>
          <article class="card rounded-3xl p-6"><span class="text-3xl">🌤️</span><h3 class="mt-5 text-xl font-extrabold">හොඳම වේලාව</h3><p class="mt-2 leading-7 text-[#665444]">අලුයම හෝ සවස. දවල් පාවහන් නොමැතිව ගමන් කරන පෘෂ්ඨ උණුසුම් විය හැකි අතර පෝය දිනවල ජනතාව වැඩි වේ.</p></article>
        </div>
      </div>
    </section>

    <section id="weather" class="section border-y border-[#755d45]/10 bg-[#f4ead7]" data-weather data-lat={LATITUDE} data-lon={LONGITUDE}>
      <div class="container">
        <div class="max-w-3xl">
          <p class="eyebrow">කාලගුණය · Weather</p>
          <h2 class="mt-3 text-4xl font-black leading-tight" lang="en">Weather &amp; 7-Day Forecast for {CITY_NAME} <span class="block text-2xl font-bold text-[#7c6753]" lang="si">අනුරාධපුරයේ වර්තමාන කාලගුණය සහ දින 7ක අනාවැකිය</span></h2>
          <p class="mt-4 leading-8 text-[#5e4c3c]">පූජනීය පරිශ්‍රයට පිවිසෙන විට පාවහන් ඉවත් කළ යුතු බැවින් බිමේ උෂ්ණත්වය, හිරු රශ්මිය සහ හදිසි වර්ෂාව සැලසුමට සෘජුවම බලපායි. Because footwear is removed at the precinct, ground heat, sun and sudden showers matter more here than at most sites.</p>
        </div>

        <div class="mt-10 grid gap-6 lg:grid-cols-[.85fr_1.15fr]">
          <div class="rounded-[2rem] bg-[#2f432f] p-8 text-white">
            <p class="text-sm font-bold tracking-[.18em] text-[#e8c877]">දැන් · Right now</p>
            <div class="mt-4 flex items-start gap-4">
              <span class="text-6xl font-black leading-none" data-wx="temp">{formatNumber(weatherNow.temperature)}°</span>
              <span class="text-5xl leading-none" data-wx="icon" aria-hidden="true">{weatherText.icon}</span>
            </div>
            <p class="mt-3 text-xl font-bold" data-wx="label">{weatherText.si}</p>
            <p class="text-sm text-[#cfd8cb]" lang="en" data-wx="label-en">{weatherText.en}</p>
            <p class="mt-4 rounded-xl bg-black/20 p-3 text-sm font-bold leading-6 text-[#eef0e8]" data-wx="summary">{weatherAdvice.headline.si}<span class="mt-1 block text-xs font-normal text-[#cfd8cb]" lang="en">{weatherAdvice.headline.en}</span></p>
            <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-4 text-sm">
              <div><dt class="text-[#b9c6b6]">දැනෙන උෂ්ණත්වය / Feels like</dt><dd class="mt-1 text-lg font-bold" data-wx="apparent">{formatNumber(weatherNow.apparentTemperature)}°</dd><dd class="text-xs text-[#cfd8cb]" data-wx="feels-word">{feelsWord.si} · {feelsWord.en}</dd></div>
              <div><dt class="text-[#b9c6b6]">වැසි සම්භාවිතාව / Rain chance</dt><dd class="mt-1 text-lg font-bold" data-wx="rain-chance">{todayRainChance}</dd></div>
              <div><dt class="text-[#b9c6b6]">සුළඟ / Wind</dt><dd class="mt-1 text-lg font-bold" data-wx="wind">{windWord.si}</dd><dd class="text-xs text-[#cfd8cb]" lang="en" data-wx="wind-en">{windWord.en}</dd></div>
              <div><dt class="text-[#b9c6b6]">හිරු රශ්මිය / UV</dt><dd class="mt-1 text-lg font-bold" data-wx="uv">{uvWord.si}</dd><dd class="text-xs text-[#cfd8cb]" lang="en" data-wx="uv-en">{uvWord.en}</dd></div>
              <div class="col-span-2"><dt class="text-[#b9c6b6]">වාතය / Air</dt><dd class="mt-1 text-base font-bold"><span data-wx="air">{airWord.si}</span> · <span lang="en" data-wx="air-en">{airWord.en}</span></dd></div>
            </dl>
            <p class="mt-6 text-xs leading-6 text-[#cfd8cb]">යාවත්කාලීන කළ වේලාව · Updated <span data-wx="updated">{weatherUpdatedLabel}</span> (Asia/Colombo)</p>
            {!weather.ok && (
              <p class="mt-3 rounded-xl bg-black/20 p-3 text-xs leading-6 text-[#f0e6d2]">සජීවී දත්ත මේ මොහොතේ ලබා ගත නොහැක; පහත අගයන් දිගුකාලීන දේශගුණික සාමාන්‍යයන් මත පදනම් වේ. Live values are unavailable at the moment, so long-term climate normals are shown.</p>
            )}
          </div>

          <div class="rounded-[2rem] border border-[#a78a67]/20 bg-white/70 p-8">
            <h3 class="text-2xl font-black">මේ කාලගුණයෙන් ඔබට කුමක් කළ යුතුද? <span class="block text-base font-bold text-[#7c6753]" lang="en">What this weather means for your visit</span></h3>

            <div class="mt-5">
              <p class="text-xs font-extrabold tracking-[.16em] text-red-700">⚠️ අවදානම් දැනුම්දීම · Risk alert</p>
              <ul class="mt-2 space-y-2" data-wx="risks">
                {weatherAdvice.risks.map((item) => (
                  <li class={ADVICE_CLASS.risk}>{item.icon} {item.si}<span class={ADVICE_CLASS.en} lang="en">{item.en}</span></li>
                ))}
              </ul>
              <p class:list={['mt-2 rounded-2xl bg-emerald-50 p-4 text-sm font-bold leading-6 text-emerald-800', weatherAdvice.risks.length ? 'hidden' : '']} data-wx="risk-empty">✅ විශේෂ අවදානම් දැනුම්දීම් නොමැත · No weather warnings can be derived from the current data.</p>
            </div>

            <div class="mt-6 space-y-5">
              <div>
                <p class="text-xs font-extrabold tracking-[.16em] text-[#b88a2d]">✅ ඇඳුම් සහ ගමන් සූදානම · What to wear</p>
                <ul class="mt-2 space-y-2" data-wx="dress">
                  {weatherAdvice.dress.map((item) => (
                    <li class={ADVICE_CLASS.item}>{item.icon} {item.si}<span class={ADVICE_CLASS.en} lang="en">{item.en}</span></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-extrabold tracking-[.16em] text-[#b88a2d]">🗺️ නැරඹීමේ සැලැස්ම · How to plan the visit</p>
                <ul class="mt-2 space-y-2" data-wx="plan">
                  {weatherAdvice.plan.map((item) => (
                    <li class={ADVICE_CLASS.item}>{item.icon} {item.si}<span class={ADVICE_CLASS.en} lang="en">{item.en}</span></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-extrabold tracking-[.16em] text-[#b88a2d]">🎒 රැගෙන යා යුතු දෑ · What to carry</p>
                <ul class="mt-2 space-y-2" data-wx="carry">
                  {weatherAdvice.carry.map((item) => (
                    <li class={ADVICE_CLASS.item}>{item.icon} {item.si}<span class={ADVICE_CLASS.en} lang="en">{item.en}</span></li>
                  ))}
                </ul>
              </div>
            </div>
            <p class="mt-5 text-xs leading-6 text-[#7c6753]">අනාවැකි යනු සම්භාවිතාවන් වේ; පූජනීය කටයුතු සඳහා දේශීය නිවේදන ද සලකා බලන්න. Forecasts are probabilities — also follow local notices for religious events.</p>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-7">
          {weatherRows.map((row) => (
            <div class="rounded-2xl border border-[#8c7765]/20 bg-white/75 p-4 text-center" data-wx-day={row.index}>
              <p class="text-xs font-extrabold text-[#b88a2d]">{row.isToday ? 'අද · Today' : row.weekdaySi}</p>
              <p class="text-xs text-[#7c6753]" lang="en">{row.dateEn}</p>
              <div class="my-3 text-3xl leading-none" data-wx-day-icon aria-hidden="true">{row.text.icon}</div>
              <p class="text-xs text-[#6d5b4a]" data-wx-day-label>{row.text.si}</p>
              <p class="mt-2 text-sm font-black"><span data-wx-day-max>{row.tempMax}</span>° / <span data-wx-day-min>{row.tempMin}</span>°</p>
              <p class="mt-1 text-xs text-[#6d5b4a]">වැසි <span data-wx-day-rain>{row.rainChance}</span></p>
              <p class="text-xs text-[#6d5b4a]">UV <span data-wx-day-uv>{row.uv}</span></p>
            </div>
          ))}
        </div>

        <p class="mt-5 text-xs leading-6 text-[#7c6753]">කාලගුණ මූලාශ්‍රය · Weather data: <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted">Open-Meteo</a> (CC BY 4.0). පිටුව විවෘතව ඇති අතරතුර අගයන් යාවත්කාලීන වේ. Values refresh while this page stays open.</p>
      </div>

      <script>
        import {
          ADVICE_CLASS,
          buildWeatherAdvice,
          buildWeatherApiUrl,
          feelsLabel,
          formatNumber,
          humidityLabel,
          normaliseWeatherPayload,
          uvLabel,
          weatherCodeToText,
          windLabel
        } from '../lib/weather-shared';

        const root = document.querySelector<HTMLElement>('[data-weather]');

        if (root) {
          const latitude = Number(root.dataset.lat);
          const longitude = Number(root.dataset.lon);
          const pad = (value: number) => String(value).padStart(2, '0');

          const stamp = (iso: string) => {
            const date = new Date(iso);
            if (Number.isNaN(date.getTime())) return '—';
            const colombo = new Date(date.getTime() + 5.5 * 60 * 60 * 1000);
            return `${colombo.getUTCFullYear()}-${pad(colombo.getUTCMonth() + 1)}-${pad(colombo.getUTCDate())} ${pad(colombo.getUTCHours())}:${pad(colombo.getUTCMinutes())}`;
          };

          const setText = (key: string, value: string) => {
            root.querySelectorAll<HTMLElement>(`[data-wx="${key}"]`).forEach((node) => {
              node.textContent = value;
            });
          };

          const renderAdvice = (key: string, items: { icon: string; si: string; en: string }[], className: string) => {
            const host = root.querySelector<HTMLElement>(`[data-wx="${key}"]`);
            if (!host) return;
            host.innerHTML = '';
            items.forEach((item) => {
              const node = document.createElement('li');
              node.className = className;
              node.textContent = `${item.icon} ${item.si}`;
              const english = document.createElement('span');
              english.className = ADVICE_CLASS.en;
              english.setAttribute('lang', 'en');
              english.textContent = item.en;
              node.appendChild(english);
              host.appendChild(node);
            });
          };

          const render = (snapshot: ReturnType<typeof normaliseWeatherPayload>) => {
            if (!snapshot) return;
            const now = snapshot.now;
            const today = snapshot.days[0] ?? null;
            const text = weatherCodeToText(now.weatherCode);
            const windWord = windLabel(now.windSpeed);
            const uvWord = uvLabel(today?.uvIndexMax ?? now.uvIndex);
            const airWord = humidityLabel(now.humidity);
            const feelsWord = feelsLabel(now);

            setText('temp', `${formatNumber(now.temperature)}°`);
            setText('icon', text.icon);
            setText('label', text.si);
            setText('label-en', text.en);
            setText('apparent', `${formatNumber(now.apparentTemperature)}°`);
            setText('feels-word', `${feelsWord.si} · ${feelsWord.en}`);
            setText('rain-chance', today?.precipitationProbability === null || today?.precipitationProbability === undefined ? '—' : `${Math.round(today.precipitationProbability)}%`);
            setText('wind', windWord.si);
            setText('wind-en', windWord.en);
            setText('uv', uvWord.si);
            setText('uv-en', uvWord.en);
            setText('air', airWord.si);
            setText('air-en', airWord.en);
            setText('updated', stamp(now.time));

            const advice = buildWeatherAdvice({ ...snapshot, days: snapshot.days.slice(0, 7) });
            const summary = root.querySelector<HTMLElement>('[data-wx="summary"]');
            if (summary) {
              summary.textContent = advice.headline.si;
              const english = document.createElement('span');
              english.className = 'mt-1 block text-xs font-normal text-[#cfd8cb]';
              english.setAttribute('lang', 'en');
              english.textContent = advice.headline.en;
              summary.appendChild(english);
            }
            renderAdvice('risks', advice.risks, ADVICE_CLASS.risk);
            renderAdvice('dress', advice.dress, ADVICE_CLASS.item);
            renderAdvice('plan', advice.plan, ADVICE_CLASS.item);
            renderAdvice('carry', advice.carry, ADVICE_CLASS.item);
            const riskEmpty = root.querySelector<HTMLElement>('[data-wx="risk-empty"]');
            if (riskEmpty) riskEmpty.classList.toggle('hidden', advice.risks.length > 0);

            snapshot.days.slice(0, 7).forEach((day, index) => {
              const card = root.querySelector<HTMLElement>(`[data-wx-day="${index}"]`);
              if (!card) return;
              const dayText = weatherCodeToText(day.weatherCode);
              const pick = (key: string) => card.querySelector<HTMLElement>(`[data-wx-day-${key}]`);
              const icon = pick('icon');
              if (icon) icon.textContent = dayText.icon;
              const label = pick('label');
              if (label) label.textContent = dayText.si;
              const max = pick('max');
              if (max) max.textContent = formatNumber(day.tempMax);
              const min = pick('min');
              if (min) min.textContent = formatNumber(day.tempMin);
              const rain = pick('rain');
              if (rain) rain.textContent = day.precipitationProbability === null ? '—' : `${Math.round(day.precipitationProbability)}%`;
              const uv = pick('uv');
              if (uv) uv.textContent = formatNumber(day.uvIndexMax);
            });

          };

          const refresh = async () => {
            if (typeof navigator !== 'undefined' && navigator.onLine === false) return;
            try {
              const response = await fetch(buildWeatherApiUrl(latitude, longitude), { headers: { accept: 'application/json' } });
              if (!response.ok) return;
              render(normaliseWeatherPayload(await response.json(), new Date().toISOString()));
            } catch {
              /* keep the values already rendered on the page */
            }
          };

          const start = () => {
            refresh();
            window.setInterval(refresh, 15 * 60 * 1000);
            document.addEventListener('visibilitychange', () => {
              if (document.visibilityState === 'visible') refresh();
            });
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', start, { once: true });
          } else {
            start();
          }
        }
      </script>
    </section>

    <section class="section">
      <div class="container grid gap-10 lg:grid-cols-2">
        <div class="rounded-[2rem] bg-[#2f432f] p-8 text-white md:p-10">
