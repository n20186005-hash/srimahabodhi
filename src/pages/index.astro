---
import '../styles/global.css';

const siteUrl = Astro.site?.toString().replace(/\/$/, '');
const canonical = siteUrl ? `${siteUrl}/` : undefined;
const ogImage = siteUrl ? `${siteUrl}/images/jaya-sri-maha-bodhi-main.jpg` : '/images/jaya-sri-maha-bodhi-main.jpg';

const attraction = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'ජය ශ්‍රී මහා බෝධිය',
  alternateName: 'Jaya Sri Maha Bodhi',
  description: 'අනුරාධපුර මහමෙව්නා උයනේ පිහිටි, ශ්‍රී ලාංකික බෞද්ධයන්ට අතිශය පූජනීය බෝධි වෘක්ෂය.',
  url: canonical,
  image: ogImage,
  telephone: '+94 25 222 2367',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '89VW+VV5',
    addressLocality: 'Anuradhapura',
    addressRegion: 'North Central Province',
    addressCountry: 'LK'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 8.3446448, longitude: 80.3972292 },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'], opens: '06:15', closes: '21:00' }
  ],
  isAccessibleForFree: true,
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.3', reviewCount: '43', bestRating: '5' }
};

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'ජය ශ්‍රී මහා බෝධිය නැරඹීමට ගාස්තුවක් තිබේද?', acceptedAnswer: { '@type': 'Answer', text: 'පූජනීය බෝධියට ප්‍රවේශය සාමාන්‍යයෙන් නොමිලේ ලෙස දක්වා ඇත. නමුත් අනුරාධපුර පුරාවිද්‍යා කලාපයේ වෙනත් ස්ථාන සඳහා වෙනම ප්‍රවේශ ගාස්තු තිබිය හැක.' } },
    { '@type': 'Question', name: 'නැරඹීමට හොඳම වේලාව කවදාද?', acceptedAnswer: { '@type': 'Answer', text: 'අලුයම හෝ සවස උණුසුම අඩු වේලාව සන්සුන් අත්දැකීමක් ලබා දෙයි. පෝය දිනවල විශාල වන්දනාකරුවන් පිරිසක් පැමිණිය හැක.' } },
    { '@type': 'Question', name: 'ඇඳුම් සහ හැසිරීම් පිළිබඳ නීති මොනවාද?', acceptedAnswer: { '@type': 'Answer', text: 'උරහිස් හා දණ වැසෙන ගෞරවාන්විත ඇඳුම් ඇඳීම සුදුසුය. පූජනීය ප්‍රදේශයට ඇතුල්වීමට පෙර සපත්තු සහ හිස්වැසුම් ඉවත් කර නිහඬව හැසිරෙන්න.' } },
    { '@type': 'Question', name: 'කොපමණ කාලයක් වෙන් කළ යුතුද?', acceptedAnswer: { '@type': 'Answer', text: 'පූජනීය පරිශ්‍රය සඳහා සාමාන්‍යයෙන් මිනිත්තු 30 සිට පැය 1.5 දක්වා වෙන් කිරීම ප්‍රමාණවත්ය. අවට රුවන්වැලි මහා සෑය හා ලෝවාමහාපාය එක් කරන්නේ නම් වැඩි කාලයක් වෙන් කරන්න.' } }
  ]
};
---
<!doctype html>
<html lang="si">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ජය ශ්‍රී මහා බෝධිය | අනුරාධපුර පූජනීය නගරය</title>
  <meta name="description" content="ජය ශ්‍රී මහා බෝධියට පැමිණීම සඳහා ප්‍රායෝගික මාර්ගෝපදේශය: ඉතිහාසය, විවෘත වේලාව, ගාස්තු, ගමනාගමනය, රථගාල්, ආහාර හා අවට පූජනීය ස්ථාන." />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content="ජය ශ්‍රී මහා බෝධිය" />
  <meta property="og:description" content="අනුරාධපුරයේ ජීවමාන පූජනීය උරුමයක් සඳහා සංචාරක මාර්ගෝපදේශය." />
  <meta property="og:image" content={ogImage} />
  {canonical && <meta property="og:url" content={canonical} />}
  <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
  <script type="application/ld+json" set:html={JSON.stringify(attraction)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faq)}></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-HXM22WWPKP');
  </script>
</head>
<body>
  <header class="absolute inset-x-0 top-0 z-20 border-b border-white/15 bg-[#211a13]/25 backdrop-blur-md">
    <div class="container flex items-center justify-between py-4">
      <a href="#top" aria-label="මුල් පිටුව" class="block rounded-xl bg-[#fffaf0]/95 px-3 py-2 shadow-lg"><img src="/logo.svg" alt="ජය ශ්‍රී මහා බෝධිය" class="h-12 w-auto" /></a>
      <nav class="hidden gap-6 text-sm font-semibold text-white md:flex"><a href="#visit">පැමිණීම</a><a href="#nearby">අවට</a><a href="#faq">ප්‍රශ්න</a></nav>
    </div>
  </header>

  <main id="top">
    <section class="relative min-h-[92vh] overflow-hidden bg-[#253426] text-white">
      <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/b/b1/Sri_Maha_Bodhi%2C_Anuradhapura.jpg/1280px-Sri_Maha_Bodhi%2C_Anuradhapura.jpg" alt="අනුරාධපුර ජය ශ්‍රී මහා බෝධි පරිශ්‍රය" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#18261c]/95 via-[#21311f]/75 to-[#7f5227]/20"></div>
      <div class="container relative z-10 flex min-h-[92vh] items-end pb-20 pt-36">
        <div class="max-w-3xl">
          <p class="mb-4 text-sm font-bold tracking-[.22em] text-[#f0d695]">අනුරාධපුර · මහමෙව්නා උයන</p>
          <h1 class="text-5xl font-black leading-[1.1] md:text-7xl">ජය ශ්‍රී<br/><span class="text-[#f0d695]">මහා බෝධිය</span></h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-[#f5efe5]">වසර දෙදහසකට වැඩි කාලයක් වන්දනා, රැකවරණය සහ ජීවමාන සම්ප්‍රදාය එක් තැනක රැඳී ඇති අනුරාධපුරයේ අතිපූජනීය බෝධි වෘක්ෂය.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#visit" class="rounded-full bg-[#d19c38] px-6 py-3 font-bold text-[#271b0f]">පැමිණීම සැලසුම් කරන්න</a>
            <a href="https://maps.app.goo.gl/Xm4DV3tAoWF94of36" rel="noreferrer" class="rounded-full border border-white/40 bg-white/10 px-6 py-3 font-bold">Google සිතියම</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
        <div>
          <p class="eyebrow">ජීවමාන උරුමය</p>
          <h2 class="mt-3 text-4xl font-black leading-tight md:text-5xl">බෝධගයාවෙන් අනුරාධපුරයට පැමිණි පූජනීය සබඳතාව</h2>
          <div class="prose mt-6 space-y-4 text-lg">
            <p>ශ්‍රී ලංකා සංචාරක ප්‍රවර්ධන අධිකාරියේ තොරතුරු අනුව, ජය ශ්‍රී මහා බෝධිය බෝධගයාවේ පූජනීය බෝධි වෘක්ෂයේ අංකුරයකින් පැවතෙන අතර සංඝමිත්තා තෙරණිය විසින් ශ්‍රී ලංකාවට ගෙන එන ලදී. දේවානම්පියතිස්ස රජුගේ යුගයේ එය මහමෙව්නා උයනේ රෝපණය කරන ලද බව සම්ප්‍රදාය සඳහන් කරයි.</p>
            <p>මෙය සරල “පැරණි ගසක්” ලෙස නොව දිනපතා වන්දනා කරන ජීවමාන පූජනීය ස්ථානයක් ලෙස බැලීම වැදගත්ය. නිහඬව, ගෞරවයෙන් සහ දේශීය ආචාර පිළිපදිමින් පැමිණීම අත්දැකීමේ මූලික කොටසකි.</p>
          </div>
        </div>
        <div class="relative">
          <div class="absolute -inset-4 -z-10 rotate-3 rounded-[2.5rem] border border-[#b88a2d]/30"></div>
          <img src="https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/SL_Anuradhapura_asv2020-01_img04_Jaya_Sri_Maha_Bodhi.jpg/1280px-SL_Anuradhapura_asv2020-01_img04_Jaya_Sri_Maha_Bodhi.jpg" alt="ජය ශ්‍රී මහා බෝධි පරිශ්‍රයේ වන්දනාකරුවන්" class="h-[520px] w-full rounded-[2.25rem] object-cover shadow-2xl" />
          <div class="absolute bottom-5 left-5 right-5 rounded-2xl bg-[#fffaf0]/92 p-4 text-sm text-[#49382a] backdrop-blur"><strong>ගෞරවයෙන් පැමිණෙන්න:</strong> සපත්තු හා හිස්වැසුම් ඉවත් කර, උරහිස් සහ දණ වැසෙන ඇඳුම් තෝරන්න.</div>
        </div>
      </div>
    </section>

    <section id="visit" class="section grid-paper border-y border-[#755d45]/10 bg-[#f4ead7]">
      <div class="container">
        <div class="max-w-2xl"><p class="eyebrow">පැමිණීමට පෙර</p><h2 class="mt-3 text-4xl font-black">ප්‍රායෝගික තොරතුරු</h2></div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          <article class="card rounded-3xl p-6"><span class="text-3xl">🕕</span><h3 class="mt-5 text-xl font-extrabold">විවෘත වේලාව</h3><p class="mt-2 leading-7 text-[#665444]">සාමාන්‍යයෙන් පෙ.ව. 6:15 සිට රාත්‍රී 9:00 දක්වා ලෙස ලැයිස්තුගත වේ. විශේෂ පූජා/පෝය දිනවල වෙනස්කම් විය හැක.</p></article>
          <article class="card rounded-3xl p-6"><span class="text-3xl">🎟️</span><h3 class="mt-5 text-xl font-extrabold">ප්‍රවේශ ගාස්තුව</h3><p class="mt-2 leading-7 text-[#665444]">බෝධි පරිශ්‍රයට ප්‍රවේශය නොමිලේ ලෙස වාර්තා වේ. අවට පුරාවිද්‍යා ස්ථාන සඳහා වෙනම ටිකට් අවශ්‍ය විය හැක.</p></article>
